generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  role          String   @default("passenger") // passenger, coordinator, driver
  phone         String?
  provider      String   @default("google") // google, credentials, email-only

  // Coordinator-specific
  passwordHash  String?  // hashed password for coordinators

  // Driver-specific
  driverPhone       String?
  pinHash           String?  // hashed 6-digit PIN for drivers
  pinChangeRequired Boolean  @default(true) // force PIN change on first login

  // Passenger-specific
  password      String?  // hashed password for passengers who sign up with email

  // Security fields
  loginAttempts Int       @default(0)    // track failed login attempts
  lockedUntil   DateTime?               // account lockout timestamp

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  assignedBuses Bus[]    // Buses where this user is the driver (inverse of Bus.driverId)
  notifications Notification[] // Notifications for this user
  preRegistrations PreRegistration[] // Pre-registrations by this user

  @@index([role])
  @@index([email])
}

model Event {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  date               DateTime
  endDate            DateTime?
  status             String   @default("upcoming") // upcoming, active, completed, cancelled
  expectedAttendance Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  routes             Route[]
  buses              Bus[]
}

model PickupPoint {
  id          String   @id @default(cuid())
  name        String
  state       String
  latitude    Float
  longitude   Float
  address     String?
  capacity    Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  routesFrom  Route[]  @relation("RouteFrom")
  routesTo    Route[]  @relation("RouteTo")
  queueEntries       QueueEntry[]
  demandForecasts    DemandForecast[]
  preRegistrations   PreRegistration[]
}

model Route {
  id             String      @id @default(cuid())
  name           String
  fromPointId    String
  toPointId      String
  distanceKm     Float?
  estimatedMin   Int?
  status         String      @default("active") // active, suspended, completed
  eventId        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  fromPoint      PickupPoint @relation("RouteFrom", fields: [fromPointId], references: [id])
  toPoint        PickupPoint @relation("RouteTo", fields: [toPointId], references: [id])
  event          Event?      @relation(fields: [eventId], references: [id])
  buses          Bus[]
}

model Bus {
  id           String    @id @default(cuid())
  plateNumber  String
  capacity     Int
  currentLoad  Int       @default(0)
  status       String    @default("available") // available, in-transit, loading, maintenance
  driverId     String?   // FK to User (driver)
  driver       User?     @relation(fields: [driverId], references: [id])
  routeId      String?
  eventId      String?
  latitude     Float?
  longitude    Float?
  lastUpdated  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  route        Route?    @relation(fields: [routeId], references: [id])
  event        Event?    @relation(fields: [eventId], references: [id])
  preRegistrations PreRegistration[] // Pre-registrations assigned to this bus
}

model QueueEntry {
  id             String      @id @default(cuid())
  pickupPointId  String
  estimatedWait  Int?        // in minutes
  queueLength    Int?
  recordedAt     DateTime    @default(now())
  pickupPoint    PickupPoint @relation(fields: [pickupPointId], references: [id])
}

model DemandForecast {
  id             String      @id @default(cuid())
  pickupPointId  String
  timeSlot       String
  predictedDemand Int
  confidence     Float?      // 0.0 to 1.0
  createdAt      DateTime    @default(now())
  pickupPoint    PickupPoint @relation(fields: [pickupPointId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info, warning, success
  target    String   @default("all")  // all, coordinator, passenger, driver
  userId    String?  // null = broadcast to target group, specific user ID = user-specific
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([target])
  @@index([read])
}

model PreRegistration {
  id             String      @id @default(cuid())
  fullName       String
  phone          String
  pickupPointId  String
  preferredTime  String?
  passengers     Int         @default(1)
  status         String      @default("pending") // pending, confirmed, cancelled
  assignedBusId  String?     // Bus assigned to this pre-registration
  userId         String?     // Link to User if they have an account
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  pickupPoint    PickupPoint @relation(fields: [pickupPointId], references: [id])
  assignedBus    Bus?        @relation(fields: [assignedBusId], references: [id])
  user           User?       @relation(fields: [userId], references: [id])

  @@index([assignedBusId])
  @@index([userId])
}
